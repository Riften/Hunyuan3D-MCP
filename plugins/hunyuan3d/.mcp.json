{
  "mcpServers": {
    "hunyuan3d": {
      "command": "uv",
      "args": ["run", "--directory", "${PLUGIN_ROOT}", "--locked", "--no-dev", "hunyuan3d-mcp"],
      "env": { "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv" },
      "env_vars": ["HY3D_API_KEY", "HY3D_TIMEOUT_SECONDS", "HY3D_PROXY", "HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "NO_PROXY"],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 180
    }
  }
}
