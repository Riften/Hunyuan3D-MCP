{
  "mcpServers": {
    "hunyuan3d": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--python",
        "3.11",
        "hunyuan3d-mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "TENCENTCLOUD_SECRET_ID",
        "TENCENTCLOUD_SECRET_KEY",
        "TENCENTCLOUD_TOKEN",
        "TENCENTCLOUD_REGION",
        "HY3D_TIMEOUT_SECONDS",
        "HY3D_PROXY",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "ALL_PROXY",
        "NO_PROXY"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 180
    }
  }
}
